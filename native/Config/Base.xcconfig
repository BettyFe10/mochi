// Valori di base del progetto. NON mettere qui le chiavi vere:
// vanno in Config/Secrets.xcconfig, che è escluso da git (vedi Secrets.example.xcconfig).

// Identificativi: cambiali con un prefisso tuo (es. it.tuonome.mochi), devono essere unici su Apple
MOCHI_BUNDLE_ID = it.bettyfe.mochi
MOCHI_APP_GROUP = group.it.bettyfe.mochi
MOCHI_TEAM_ID =

// Vuoti = modalità prova (dati solo sul dispositivo)
SUPABASE_URL =
SUPABASE_ANON_KEY =
WEB_APP_URL =

// Se esiste, Secrets.xcconfig sovrascrive i valori sopra
#include? "Secrets.xcconfig"
