// Copia questo file in "Secrets.xcconfig" (stessa cartella) e inserisci i tuoi valori.
// Secrets.xcconfig è escluso da git: le chiavi non finiscono mai nel repository.
//
// ATTENZIONE: nei file .xcconfig "//" inizia un commento, quindi negli indirizzi
// si scrive https:/$()/ al posto di https:// (è il trucco standard di Xcode).

MOCHI_TEAM_ID = ABCDE12345
SUPABASE_URL = https:/$()/abcdefgh.supabase.co
SUPABASE_ANON_KEY = eyJhbGciOi...la-tua-chiave-anon-public
WEB_APP_URL = https:/$()/bettyfe10.github.io/mochi/
